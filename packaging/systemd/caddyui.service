[Unit]
Description=CaddyUI
Documentation=https://github.com/X4Applegate/caddyui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caddyui
Group=caddyui
Environment=CADDYUI_DB=/var/lib/caddyui/caddyui.db
Environment=CADDYUI_LISTEN=127.0.0.1:8080
Environment=CADDY_ADMIN_URL=http://127.0.0.1:2019
# Optional visitor-analytics ingest listener. Set to an empty value to disable.
Environment=CADDYUI_INGEST_LISTEN=127.0.0.1:9019
ExecStart=/usr/local/bin/caddyui
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/caddyui

[Install]
WantedBy=multi-user.target
