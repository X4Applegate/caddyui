# Cross-compile on the builder's native platform: xcaddy honours GOOS/GOARCH,
# so `--platform linux/amd64,linux/arm64` works from one Dockerfile. The only
# step that runs inside the target image is the final stage's `apk upgrade`,
# which needs QEMU for arm64 (release-docker.yml sets it up).
#
# Security pins:
#   - The first three --with lines are version floors. xcaddy runs `go get` once
#     per --with, in order, and `go get pkg@ver` sets exactly that version, so
#     they must come first: a plugin fetched after them can still raise these
#     modules but never lowers them. crowdsec/pkg/apiclient @v1.7.8 lifts
#     CrowdSec past CVE-2026-44982, x/net/http2 @v0.62.0 lifts golang.org/x/net
#     past CVE-2026-78669, CVE-2026-78661 and CVE-2026-97045, and chi/v5 @v5.4.0
#     lifts go-chi past CVE-2026-114437.
#     Caddy already links these packages, so the blank import xcaddy adds for
#     each changes nothing else. The build fails if `go get` ever reports a
#     downgrade, so a pin can't quietly pull a plugin back to an older release.
#   - crowdsec @v1.7.8 carries THREE GitHub advisories that OSV does not hold at
#     all -- not by package, not by the pinned version's commit, and not by id
#     (`GET https://api.osv.dev/v1/vulns/<ghsa>` returns `code 5` for each).
#     None has a CVE id, the same pattern T-0646 found for go-jose, so Trivy and
#     the image gate are blind to them too (T-0628) and a green gate is not
#     evidence here. All three are present-but-NOT-LINKED, measured on the
#     published binary and on the module graph rather than assumed (T-0653):
#       GHSA-rh69-4vqj-9gj8  medium  <= 1.7.8   fixed 1.8.0  kubernetes-audit
#                            acquisition webhook, unbounded request-body read
#       GHSA-g2x2-jgfg-pg7g  medium  <= 1.7.8   fixed 1.8.0  HTTP acquisition
#                            datasource, no decompressed-body cap, trusts
#                            Content-Length
#       GHSA-g9hc-g4w6-4mfx  low     <= 1.8.1   NO FIX YET   hardcoded
#                            InsecureSkipVerify in the notification-splunk
#                            plugin (cmd/notification-splunk/main.go:116)
#     This image pins `crowdsec/pkg/apiclient` -- the LAPI *client*, which is
#     what caddy-crowdsec-bouncer talks to. The whole transitive package
#     closure of that pin plus the bouncer is six packages: pkg/apiclient,
#     pkg/apiclient/useragent, pkg/fflag, pkg/models, pkg/modelscapi and
#     pkg/types. `go mod why` answers "main module does not need package" for
#     pkg/acquisition, both affected acquisition modules AND pkg/csplugin, and
#     `strings` on the binary from :stable finds 0 refs to any of them (against
#     456 for pkg/models as a control). The two acquisition bugs are how a
#     crowdsec AGENT ingests logs; this image runs no agent. The splunk one is
#     `package main` in cmd/, a standalone plugin binary Go cannot link into
#     another program even in principle -- so its missing fix cannot bind here.
#     Therefore do NOT raise this floor for these three: v1.8.0 would clear two
#     of them and v1.8.2 still would not clear the splunk one, while buying no
#     reachable fix and risking the build for a bouncer that needs 1.7.x.
#     A FOURTH row, GHSA-273h-gvwr-c3qj (CVE-2026-44981, LAPI unbounded gzip
#     decompression), is already cleared: its range is >= 1.7.0 patched in
#     1.7.8, i.e. exactly this pin. It still shows in the weekly report because
#     the range filter only drops a row on a demonstrable upper bound and that
#     range leads with `>=`. Conservative by design, not a bug.
#     Re-check if the bouncer ever links acquisition or notification code, or
#     if the splunk advisory gets a fixed release (T-0661).
#   - caddy-crowdsec-bouncer @bdd7e516 is an exact pin: the upstream commit that
#     supports CrowdSec 1.7. v0.14.1, the newest tag, needs CrowdSec 1.6; the
#     commit's only code change since then is that fix. Go back to a tag once
#     one exists.
#   - EVERY --with below carries a version. An unpinned --with re-resolves to
#     whatever is latest at build time, so a base-layer refresh (an Alpine CVE,
#     a -pN tag) could pull new third-party code into the binary on all six
#     boxes — including a DNS provider holding TLS-cert API credentials and the
#     Coraza WAF. caddy-image-gate.sh blocks such a build from publishing by
#     diffing `caddy list-modules --versions`, but that is detection after the
#     fact: it stops the refresh rather than the drift, so an unrelated plugin
#     release holds the CVE fix hostage until a human investigates. Pinning
#     makes a plugin bump a deliberate edit, reviewed and versioned like any
#     other change, and leaves the gate as a second, independent check.
#     The trade, accepted knowingly: plugin fixes no longer arrive on their own
#     and need a deliberate bump here — the same trade already made for
#     crowdsec, x/net and chi.
#     caddy-dns/digitalocean has never been tagged upstream, so its pin is the
#     pseudo-version of master@04bde286 (2025-06-06) — the exact commit the
#     published image already contains, not a new choice.
#   - A pin that is behind upstream ON PURPOSE carries a `# pin-watch: floor`
#     comment immediately above it, read by scripts/check-pinned-modules.sh.
#     Such a pin is reported under "Intentional floors" with its reason rather
#     than counted as behind, so a decision that has already been taken stops
#     producing an `attention` verdict on every weekly run — a signal that is
#     always on carries no information (T-0651). It is an ACKNOWLEDGEMENT, not
#     an exclusion: `pin=`, `against=` and `reason=` are all required, the
#     acknowledgement expires by itself once upstream moves past `against=`,
#     an advisory on the pinned version always outranks it, and a directive
#     whose `pin=` no longer matches the line below it is a hard error rather
#     than a floor quietly inherited by a new version. So re-pinning a floored
#     module means re-taking the decision, which is the point.
FROM --platform=$BUILDPLATFORM caddy:2.11.7-builder AS builder
ARG TARGETOS=linux
ARG TARGETARCH
RUN set -o pipefail && GOOS=${TARGETOS} GOARCH=${TARGETARCH} xcaddy build \
    # pin-watch: floor pin=v1.7.8 against=v1.8.2 ref=T-0636 reason=v1.7.8 is the exact version fixing CVE-2026-44982 and CVE-2026-44981, so it is still a true CVE boundary, and OSV holds nothing at either version. The 3 GitHub-only advisories here are acquisition/notification code, outside the 6-package closure of pkg/apiclient + the bouncer, so none is linked and a bump buys no reachable fix; v1.8.2 still would not clear the splunk one. Measured: header, T-0653.
    --with github.com/crowdsecurity/crowdsec/pkg/apiclient@v1.7.8 \
    --with golang.org/x/net/http2@v0.62.0 \
    --with github.com/go-chi/chi/v5@v5.4.0 \
    --with github.com/caddy-dns/cloudflare@v0.2.4 \
    --with github.com/caddy-dns/porkbun@v0.3.1 \
    --with github.com/caddy-dns/namecheap@v1.0.0 \
    --with github.com/caddy-dns/godaddy@v1.2.0 \
    --with github.com/caddy-dns/digitalocean@v0.0.0-20250606074528-04bde2867106 \
    --with github.com/caddy-dns/hetzner/v2@v2.0.1 \
    --with github.com/caddy-dns/route53@v1.6.2 \
    --with github.com/caddy-dns/gandi@v1.2.1 \
    --with github.com/hslatman/caddy-crowdsec-bouncer/http@bdd7e516ec46fede2321a99d62ba63f9b9ebd857 \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --with github.com/mholt/caddy-l4@v0.1.2 \
    --with github.com/corazawaf/coraza-caddy/v2@v2.6.2 \
    2>&1 | tee /tmp/xcaddy.log \
    && if grep 'go: downgraded' /tmp/xcaddy.log; then echo 'a pin downgraded a module' >&2; exit 1; fi

FROM caddy:2.11.7-alpine
# The caddy base image only gets Alpine fixes when it is rebuilt upstream;
# upgrade here so this image ships them (e.g. brotli-libs 1.2.1, CVE-2026-111497).
RUN apk upgrade --no-cache
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
