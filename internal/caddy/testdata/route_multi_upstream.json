{
  "handle": [
    {
      "handler": "reverse_proxy",
      "load_balancing": {
        "selection_policy": {
          "policy": "round_robin"
        }
      },
      "upstreams": [
        {
          "dial": "backend:8080"
        },
        {
          "dial": "backend-2:8080"
        },
        {
          "dial": "backend-3:8080"
        }
      ]
    }
  ],
  "match": [
    {
      "host": [
        "app.example.com",
        "www.app.example.com"
      ]
    }
  ],
  "terminal": true
}
